# Copy to .env and edit
LOG_PATH=logs/app.log
WINDOW_SEC=60
WARMUP_SEC=60
MIN_EVENTS=20
COOLDOWN_SEC=30
RENOTIFY_SEC=300
EWMA_ALPHA=0.02
ADAPT_MAX_Z=2.0
RECOVERY_TICKS=5

# AWS (leave false to run without an AWS account)
AWS_ENABLED=false
AWS_REGION=ap-south-1
CW_LOG_GROUP=/log-anomaly-detector/alerts
CW_LOG_STREAM=alerts
SNS_TOPIC_ARN=
# Credentials for the limited IAM user (docs/AWS_SETUP.md). Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_MIN_SEVERITY=HIGH
